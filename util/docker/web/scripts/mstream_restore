#!/usr/bin/env bash

bool() {
    case "$1" in
    Y* | y* | true | TRUE | 1) return 0 ;;
    esac
    return 1
}

if [ "$(whoami)" != 'mstream' ]; then
    echo 'This script must be run as the "mstream" user. Rerunning...'
    exec gosu mstream mstream_restore "$@"
fi

echo "MStream Backup Restore"

APPLICATION_ENV="${APPLICATION_ENV:-production}"
echo "(Environment: $APPLICATION_ENV)"

if [ "$APPLICATION_ENV" = "production" ]; then
    if bool "$COMPOSER_PLUGIN_MODE"; then
        composer update --no-dev --optimize-autoloader
    fi
else
    composer install
fi

exec mstream_cli mstream:restore "$@"
