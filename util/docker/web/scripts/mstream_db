#!/usr/bin/env bash

if [ "$(whoami)" != 'mysql' ]; then
    echo 'This script must be run as the "mysql" user. Rerunning...'
    exec gosu mysql mstream_db "$@"
fi

MYSQL_HOST="${MYSQL_HOST:-localhost}"
MYSQL_PORT="${MYSQL_PORT:-3306}"
MYSQL_USER="${MYSQL_USER:-mstream}"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-mstream_secret}"
MYSQL_DATABASE="${MYSQL_DATABASE:-mstream}"

exec mariadb --user="${MYSQL_USER}" --password="${MYSQL_PASSWORD}" \
    --host="${MYSQL_HOST}" --port="${MYSQL_PORT}" --database="${MYSQL_DATABASE}" "$@"
