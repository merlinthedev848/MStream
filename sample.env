COMPOSE_PROJECT_NAME=merlinbx

MERLIN_BX_HTTP_PORT=80
MERLIN_BX_HTTPS_PORT=443

MERLIN_BX_SFTP_PORT=2022

MERLIN_BX_PUID=1000
MERLIN_BX_PGID=1000

# Backward-compatible environment fallbacks
AZURACAST_HTTP_PORT=${MERLIN_BX_HTTP_PORT:-80}
AZURACAST_HTTPS_PORT=${MERLIN_BX_HTTPS_PORT:-443}
AZURACAST_SFTP_PORT=${MERLIN_BX_SFTP_PORT:-2022}
AZURACAST_PUID=${MERLIN_BX_PUID:-1000}
AZURACAST_PGID=${MERLIN_BX_PGID:-1000}

NGINX_TIMEOUT=1800
