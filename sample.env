COMPOSE_PROJECT_NAME=mstream

MSTREAM_VERSION=latest
APPLICATION_ENV=production

# Base container runtime image
MSTREAM_IMAGE=ghcr.io/merlinthedev848/mstream
MSTREAM_UPDATER_IMAGE=containrrr/watchtower

MSTREAM_HTTP_PORT=80
MSTREAM_HTTPS_PORT=443

MSTREAM_SFTP_PORT=2022

MSTREAM_PUID=1000
MSTREAM_PGID=1000

NGINX_TIMEOUT=1800
